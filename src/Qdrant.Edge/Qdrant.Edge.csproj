<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AssemblyName>Qdrant.Edge</AssemblyName>
    <RootNamespace>Qdrant.Edge</RootNamespace>
    <PackageId>Qdrant.Edge</PackageId>
    <VersionPrefix>0.9.0</VersionPrefix>
    <Authors>electroglyph</Authors>
    <Copyright>Copyright (c) 2026, electroglyph</Copyright>
    <Description>Idiomatic C# interface for qdrant_edge (embedded single-shard vector search). Native engine via stable C ABI; managed DTOs with source-generated JSON.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/electroglyph/qdrant_edge_cs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>qdrant;vector-search;ann;embeddings</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Qdrant.Edge.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
